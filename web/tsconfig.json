{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  // The service worker runs in a WebWorker global scope, not DOM — it
  // conflicts with the `lib: ["DOM", ...]` above (both declare a different
  // `self`). It is therefore excluded HERE and checked by tsconfig.sw.json
  // instead, which the `typecheck` script runs as a second pass so sw.ts is
  // covered by the same gate as everything else. Vite/esbuild bundle it at
  // build time regardless of either program.
  "exclude": ["src/sw.ts"]
}
