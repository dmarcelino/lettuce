{
  "name": "letta-code-ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "bff",
    "web"
  ],
  "scripts": {
    "verify": "bun scripts/verify.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "smoke": "bun scripts/persistence-smoke.ts",
    "deploy-check": "bun scripts/deploy-check.ts",
    "sync-upstream": "bash scripts/sync-upstream.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@letta-ai/letta-code": "file:../letta-code",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": []
}
