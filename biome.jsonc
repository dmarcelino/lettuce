{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/node_modules", "!web/dist", "!bun.lock", "!docker/secrets"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Matches the width the codebase was already written to; Biome defaults to 80.
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        // Downgraded deliberately, not out of laziness. Several effects depend on
        // `scope?.agent_id` / `scope?.conversation_id` rather than `scope`, because
        // `scope` is a fresh object literal on every render (App.tsx). Satisfying
        // this rule would re-run those effects every render and reintroduce the
        // unbounded app-server request loop documented in use-session.ts.
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        // Index keys are correct for the static diff-hunk and file-row lists that
        // trigger this; the arrays are never reordered.
        "noArrayIndexKey": "warn"
      },
      "style": {
        // tsconfig sets noUncheckedIndexedAccess, which makes `!` the idiomatic
        // escape after an explicit length/guard check.
        "noNonNullAssertion": "warn"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      // Probe and test harnesses talk to the wire protocol, where `any` at the
      // boundary is the honest type and `!` follows an assertion that just ran.
      "includes": ["scripts/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
